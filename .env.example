# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ono?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication session policy (server-enforced). All values are optional and
# clamped to safe bounds; the defaults below match the product requirements.
# SESSION_IDLE_MINUTES="30"
# SESSION_ABSOLUTE_HOURS="12"
# SESSION_WARNING_MINUTES="2"
# SESSION_REMEMBER_IDLE_DAYS="7"
# SESSION_REMEMBER_ABSOLUTE_DAYS="30"
# SESSION_TOUCH_SECONDS="60"

# Outbound email transport: "console" (development only) or "disabled".
# There is no SMTP/provider adapter in this repository, so "console" logs
# verification and reset links locally and production fails closed.
EMAIL_TRANSPORT="console"

# Optional AI provider for the CRM copilot.
# Disabled by default. When disabled, the copilot answers deterministically from
# workspace records. If enabled, all three values are required on the server.
AI_PROVIDER_ENABLED="false"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""
# OpenAI-compatible base URL. Defaults to https://api.openai.com/v1.
AI_PROVIDER_BASE_URL=""
