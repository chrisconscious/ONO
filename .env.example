# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ono?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI provider for the CRM copilot.
# Disabled by default. When disabled, the copilot answers deterministically from
# workspace records. If enabled, all three values are required on the server.
AI_PROVIDER_ENABLED="false"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""
# OpenAI-compatible base URL. Defaults to https://api.openai.com/v1.
AI_PROVIDER_BASE_URL=""
