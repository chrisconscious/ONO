  email        String?
  phone        String?
  jobTitle     String?
  departmentId String?
  branchId     String?
  userId       String?
  hireDate     DateTime?
  status       EmploymentStatus @default(ACTIVE)
  baseSalary   Decimal?         @db.Decimal(14, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
