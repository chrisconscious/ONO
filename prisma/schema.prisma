}

model Handover {
  id           String       @id @default(cuid())
  tenantId     String
  kind         HandoverKind
  sourceType   String
  sourceId     String
  targetId     String
  idempotencyKey String     @unique
  createdBy    String?
  createdAt    DateTime     @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, kind, sourceId])
  @@index([tenantId, kind])
  @@map("handovers")
}

model SupportTicket {
