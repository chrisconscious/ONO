// ONO — multi-tenant business operations platform (Prisma / PostgreSQL).
// Tenant isolation: every tenant-owned model carries a required `tenantId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
}

enum MemberRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  DO_NOT_CONTACT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum OpportunityStage {
  IDENTIFICATION
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductType {
  GOODS
  SERVICE
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum InsightKind {
  INSIGHT
  RECOMMENDATION
  PREDICTION
}

enum InsightStatus {
  GENERATED
  UNDER_REVIEW
  APPROVED
  DISMISSED
  ACTED_UPON
}

enum IntegrationStatus {
  ENABLED
  DISABLED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  // Full lifecycle supported by the backend state machine. Only transitions
  // declared in subscription-service are permitted; arbitrary status
  // changes are rejected server-side.
  PENDING_ACTIVATION
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  RESTRICTED
  SUSPENDED
  CANCELLED
  EXPIRED
  TERMINATED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum UsageMetric {
  ACTIVE_USERS
  API_REQUESTS
  AI_INFERENCES
  AUTOMATION_RUNS
  STORAGE_BYTES
}

enum PaymentEventKind {
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  REFUND_ISSUED
}

enum ApprovalEntityType {
  FINANCE_EXPENSE
  FINANCE_INVOICE_ADJUSTMENT
  FINANCE_BUDGET_CHANGE
  SALES_DISCOUNT
  PROCUREMENT_PURCHASE_REQUEST
  PROJECT_SCOPE_CHANGE
  WORKFORCE_LEAVE
  DATA_EXPORT
  AUTOMATION_HIGH_IMPACT
  AI_RECOMMENDATION
}

enum WorkflowTriggerEvent {
  LEAD_CREATED
  LEAD_QUALIFIED
  OPPORTUNITY_STAGE_CHANGED
  ORDER_CONFIRMED
  STOCK_REORDER_ALERT
  INVOICE_ISSUED
  APPROVAL_DECIDED
}

enum AutomationActionType {
  CREATE_FOLLOWUP
  NOTIFY
  ASSIGN_TASK
}

enum HandoverKind {
  ORDER_DELIVERY
  ORDER_PROJECT
  ORDER_INVOICE
  OPPORTUNITY_PROJECT
}

enum SupportTicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum InsightSourceType {
  RULE_ENGINE
  MANUAL
  EXTERNAL_MODEL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowRunStatus {
  COMPLETED
  FAILED
  SKIPPED_DUPLICATE
  SKIPPED_LOOP_GUARD
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  industryKey    String?
  isActive       Boolean  @default(true)
  // --- Stage 14 provisioning lifecycle -----------------------------------
  // Provisioning state is server-controlled; clients never supply it.
  // PENDING_SETUP -> PROVISIONED -> ACTIVE, with RESTRICTED / SUSPENDED /
  // PENDING_CLOSURE / CLOSED for lifecycle management.
  provisioningStatus String @default("PENDING_SETUP")
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branches       Branch[]
  memberships    Membership[]
  dataCategories      DataCategory[]
  processingPurposes  ProcessingPurpose[]
  consentRecords      ConsentRecord[]
  retentionPolicies   RetentionPolicy[]
  legalHolds          LegalHold[]
  deletionRequests    DeletionRequest[]
  exportJobs          ExportJob[]
  aiDataUseApprovals  AiDataUseApproval[]
  dataIncidents       DataIncident[]
  departments    Department[]
  invitations    Invitation[]
  sessions       SessionsTenantJoin[]
  auditLogs      AuditLog[]
  settings       OrganizationSetting[]
  customIndustries CustomIndustry[]
  leadSources    LeadSource[]
  leads          Lead[]
  contacts       Contact[]
  companies      Company[]
  activities     Activity[]
  followUps      FollowUp[]
  pipelines      Pipeline[]
  opportunities  Opportunity[]
  proposals      Proposal[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  campaigns      Campaign[]
  products       Product[]
  warehouses     Warehouse[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payments       Payment[]
  expenses       Expense[]
  projects       Project[]
  tasks          Task[]
  milestones     Milestone[]
  approvals      Approval[]
  employees      Employee[]
  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  documents      Document[]
  notifications  Notification[]
  kpis           Kpi[]
  insights       AiInsight[]
  integrations   IntegrationConfig[]
  documentCounters DocumentCounter[]
  idempotencyRecords IdempotencyRecord[]
  approvalSteps  ApprovalStep[]
  workflowRules  WorkflowRule[]
  workflowRuns   WorkflowRun[]
  handovers      Handover[]
  supportTickets SupportTicket[]
  subscription      Subscription?
  usageRecords      UsageRecord[]
  industryCatalogue IndustryCatalogue? @relation(fields: [industryKey], references: [key], onDelete: SetNull)
  @@index([isActive])
  @@map("tenants")
}

model DocumentCounter {
  id       String  @id @default(cuid())
  tenantId String
  prefix   String
  seq      Int     @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, prefix])
  @@map("document_counters")
}

model IdempotencyRecord {
  id          String    @id @default(cuid())
  tenantId    String
  key         String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([key])
  @@index([tenantId, createdAt])
  @@map("idempotency_records")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  warehouses  Warehouse[]
  employees   Employee[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Department {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent    Department? @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DeptTree")
  employees Employee[]
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(PLATFORM_ADMIN)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  memberships  Membership[]
  sessions     Session[]
  invitations  Invitation[] @relation("InvitedBy")
  auditLogs    AuditLog[]
  consentRecords ConsentRecord[]
  assignedTasks Task[]
  createdLeads  Lead[] @relation("LeadOwner")
  employeeRecords Employee[]
  @@map("users")
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  tenantId     String
  role         MemberRole @default(MEMBER)
  departmentId String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]
  deletionRequestsRequested DeletionRequest[]
  exportJobsRequested       ExportJob[]
  aiDataUseRequests         AiDataUseApproval[]
  incidentAssignments       DataIncident[]
  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  role        MemberRole       @default(MEMBER)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  @@index([tenantId, status])
  @@index([email])
  @@map("invitations")
}

model Session {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  status    SessionStatus @default(ACTIVE)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime      @default(now())
  revokedAt DateTime?
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenants SessionsTenantJoin[]
  @@index([userId, status])
  @@map("sessions")
}

model SessionsTenantJoin {
  sessionId String
  tenantId  String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([sessionId, tenantId])
  @@map("sessions_tenants")
}

model AuditLog {
  id           String        @id @default(cuid())
  tenantId     String?
  userId       String?
  membershipId String?
  action       String
  entityType   String
  entityId     String?
  severity     AuditSeverity @default(INFO)
  summary      String
  metadata     Json?
  ip           String?
  createdAt    DateTime      @default(now())
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model IndustryCatalogue {
  key            String  @id
  name           String
  category       String
  defaultModules Json
  terminology    Json?
  isCustomizable Boolean @default(true)
  tenants Tenant[]
  @@map("industry_catalogue")
}

model CustomIndustry {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  activities  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, name])
  @@map("custom_industries")
}

model OrganizationSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, key])
  @@map("organization_settings")
}

model LeadSource {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  channel  String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  @@unique([tenantId, name])
  @@map("lead_sources")
}

model Lead {
  id                 String     @id @default(cuid())
  tenantId           String
  title              String
  company            String?
  email              String?
  phone              String?
  status             LeadStatus @default(NEW)
  sourceId           String?
  ownerId            String?
  valueEstimate      Decimal?   @db.Decimal(14, 2)
  notes              String?
  convertedContactId String?
  convertedCompanyId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  owner       User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]
  followUps   FollowUp[]
  opportunity Opportunity?
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("leads")
}

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  website   String?
  industry  String?
  address   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]
  invoices      Invoice[]
  supportTickets SupportTicket[]
  @@unique([tenantId, name])
  @@map("companies")
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  companyId String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities Activity[]
  followUps  FollowUp[]
  supportTickets SupportTicket[]
  @@index([tenantId, lastName])
  @@index([tenantId, email])
  @@map("contacts")
}

model Activity {
  id         String       @id @default(cuid())
  tenantId   String
  type       ActivityType
  subject    String
  body       String?
  occurredAt DateTime     @default(now())
  leadId     String?
  contactId  String?
  assignedTo String?
  createdAt  DateTime     @default(now())
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([tenantId, occurredAt])
  @@map("activities")
}

model FollowUp {
  id          String    @id @default(cuid())
  tenantId    String
  leadId      String?
  contactId   String?
  dueAt       DateTime
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([tenantId, dueAt])
  @@map("follow_ups")
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  stages    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  @@unique([tenantId, name])
  @@map("pipelines")
}

model Opportunity {
  id                String           @id @default(cuid())
  tenantId          String
  pipelineId        String?
  name              String
  stage             OpportunityStage @default(IDENTIFICATION)
  amount            Decimal?         @db.Decimal(14, 2)
  currency          String           @default("USD")
  expectedCloseDate DateTime?
  leadId            String?          @unique
  companyId         String?
  ownerId           String?
  probability       Int              @default(10)
  lostReason        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline    Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  proposals   Proposal[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  @@index([tenantId, stage])
  @@map("opportunities")
}

model Proposal {
  id            String         @id @default(cuid())
  tenantId      String
  opportunityId String
  number        String
  title         String
  body          String?
  amount        Decimal?       @db.Decimal(14, 2)
  status        DocumentStatus @default(DRAFT)
  validUntil    DateTime?
  submittedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([tenantId, number])
  @@map("proposals")
}

model Quotation {
  id            String         @id @default(cuid())
  tenantId      String
  opportunityId String
  number        String
  lines         Json
  total         Decimal        @db.Decimal(14, 2)
  status        DocumentStatus @default(DRAFT)
  validUntil    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([tenantId, number])
  @@map("quotations")
}

model SalesOrder {
  id            String           @id @default(cuid())
  tenantId      String
  number        String
  opportunityId String?
  companyId     String?
  lines         Json
  total         Decimal          @db.Decimal(14, 2)
  status        SalesOrderStatus @default(DRAFT)
  warehouseId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  invoice     Invoice?
  @@unique([tenantId, number])
  @@map("sales_orders")
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  channel     String?
  status      CampaignStatus @default(DRAFT)
  budget      Decimal?       @db.Decimal(14, 2)
  spent       Decimal?       @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  leadsCount  Int            @default(0)
  conversions Int            @default(0)
  revenue     Decimal?       @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
  @@map("campaigns")
}

model Product {
  id           String      @id @default(cuid())
  tenantId     String
  sku          String
  name         String
  description  String?
  type         ProductType @default(GOODS)
  unitPrice    Decimal     @db.Decimal(14, 2)
  costPrice    Decimal?    @db.Decimal(14, 2)
  taxRate      Decimal?    @db.Decimal(5, 2)
  reorderPoint Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockItems     StockItem[]
  stockMovements StockMovement[]
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@map("products")
}

model Warehouse {
  id        String  @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  code      String
  location  String?
  isPrimary Boolean @default(false)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockItems     StockItem[]
  stockMovements StockMovement[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId, code])
  @@map("warehouses")
}

model StockItem {
  id          String  @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Decimal @default(0) @db.Decimal(14, 3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@map("stock_items")
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  reference   String?
  reason      String?
  createdAt   DateTime          @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  terms     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId, name])
  @@map("suppliers")
}

model PurchaseOrder {
