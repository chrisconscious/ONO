generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  MEMBER
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSING
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum IndustryStatus {
  PUBLISHED
  PROVISIONAL
  DEPRECATED
}

enum IndustrySource {
  CURATED
  CUSTOM_PROMOTED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  ASSIGN_ROLE
  REVOKE_ACCESS
  APPROVE
  REJECT
  EXPORT
  SUSPEND
  ACTIVATE
}

enum TestimonialStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  STATUS_CHANGE
  STAGE_CHANGE
  CONVERSION
  SYSTEM
}

enum AutomationTriggerType {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_ASSIGNED
  LEAD_INACTIVE
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_WON
  OPPORTUNITY_STALLED
  TASK_OVERDUE
}

enum AutomationRunStatus {
  SUCCEEDED
  FAILED
  SKIPPED
}

enum NotificationType {
  INFO
  TASK
  LEAD
  OPPORTUNITY
  AUTOMATION
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

/// A customer organisation. All tenant-scoped records belong to a tenant.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PROVISIONING)
  industry  String?
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                  User[]
  memberships            Membership[]
  invitations            Invitation[]
  roles                  Role[]
  permissions            Permission[]
  rolePermissions        RolePermission[]
  branches               Branch[]
  industries             TenantIndustry[]
  customIndustries       CustomIndustry[]
  leads                  Lead[]
  contacts               Contact[]
  companies              Company[]
  opportunities          Opportunity[]
  products               Product[]
  quotations             Quotation[]
  salesOrders            SalesOrder[]
  tasks                  Task[]
  invoices               Invoice[]
  payments               Payment[]
  expenses               Expense[]
  purchaseOrders         PurchaseOrder[]
  suppliers              Supplier[]
  projects               Project[]
  supportCases           SupportCase[]
  auditLogs              AuditLog[]
  documents              Document[]
  testimonials           Testimonial[]
  warehouses             Warehouse[]
  stockMovements         StockMovement[]
  activities             CrmActivity[]
  notifications          Notification[]
  automations            AutomationWorkflow[]
  automationRuns         AutomationRun[]
  opportunityStageEvents OpportunityStageEvent[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(MEMBER)
  tenantId     String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  memberships            Membership[]
  sessions               Session[]
  assignedLeads          Lead[]                  @relation("LeadOwner")
  assignedContacts       Contact[]               @relation("ContactOwner")
  assignedCompanies      Company[]               @relation("CompanyOwner")
  assignedOpportunities  Opportunity[]           @relation("OpportunityOwner")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  auditLogs              AuditLog[]
  submittedTestimonials  Testimonial[]           @relation("TestimonialSubmitter")
  stockMovements         StockMovement[]
  activities             CrmActivity[]
  notifications          Notification[]
  automationsCreated     AutomationWorkflow[]    @relation("AutomationCreatedBy")
  automationsUpdated     AutomationWorkflow[]    @relation("AutomationUpdatedBy")
  automationRuns         AutomationRun[]
  opportunityStageEvents OpportunityStageEvent[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id        String           @id @default(cuid())
  tenantId  String
  email     String
  roleId    String?
  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  invitedBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id])

  @@index([tenantId])
  @@index([tokenHash])
  @@map("invitations")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  tenantId    String?
  code        String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model RoleAssignment {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("role_assignments")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Industry {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  parentId    String?
  synonyms    String[]
  description String?
  status      IndustryStatus @default(PUBLISHED)
  source      IndustrySource @default(CURATED)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   Industry?        @relation("IndustryHierarchy", fields: [parentId], references: [id])
  children Industry[]       @relation("IndustryHierarchy")
  tenants  TenantIndustry[]

  @@map("industries")
}

model TenantIndustry {
  id         String   @id @default(cuid())
  tenantId   String
  industryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, industryId])
  @@index([tenantId])
  @@map("tenant_industries")
}

model CustomIndustry {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String    @default("PENDING_REVIEW")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("custom_industries")
}

model Lead {
  id                     String     @id @default(cuid())
  tenantId               String
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  companyName            String?
  jobTitle               String?
  industry               String?
  source                 String?
  status                 LeadStatus @default(NEW)
  ownerId                String?
  estimatedValue         Decimal?   @db.Decimal(15, 2)
  currency               String     @default("TZS")
  expectedConversionDate DateTime?
  lastContactedAt        DateTime?
  qualifiedAt            DateTime?
  convertedAt            DateTime?
  convertedContactId     String?
  convertedCompanyId     String?
  convertedOpportunityId String?
  lostReason             String?
  notes                  String?
  score                  Int?
  scoreMethod            String?
  scoreFactors           Json?
  scoreSampleSize        Int        @default(0)
  scoreUpdatedAt         DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                User?         @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedContact     Contact?      @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedCompany     Company?      @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity?  @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  activities           CrmActivity[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([tenantId, score])
  @@index([tenantId, lastContactedAt])
  @@map("leads")
}

model Contact {
  id              String    @id @default(cuid())
  tenantId        String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  title           String?
  status          String    @default("ACTIVE")
  ownerId         String?
  companyId       String?
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company?      @relation(fields: [companyId], references: [id])
  owner              User?         @relation("ContactOwner", fields: [ownerId], references: [id])
  convertedFromLeads Lead[]        @relation("LeadConvertedContact")
  activities         CrmActivity[]

  @@index([tenantId])
  @@index([companyId])
  @@index([ownerId])
  @@map("contacts")
}

model Company {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  website           String?
  phone             String?
  email             String?
  industry          String?
  size              String?
  status            String    @default("ACTIVE")
  ownerId           String?
  notes             String?
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User?         @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts           Contact[]
  opportunities      Opportunity[]
  convertedFromLeads Lead[]        @relation("LeadConvertedCompany")
  activities         CrmActivity[]

  @@index([tenantId])
  @@index([ownerId])
  @@map("companies")
}

model Opportunity {
  id                   String           @id @default(cuid())
  tenantId             String
  name                 String
  companyId            String?
  stage                OpportunityStage @default(PROSPECTING)
  amount               Decimal?         @db.Decimal(15, 2)
  currency             String           @default("TZS")
  probability          Int              @default(0)
  winProbability       Int?
  probabilityMethod    String?
  probabilityFactors   Json?
  probabilityUpdatedAt DateTime?
  expectedCloseDate    DateTime?
  ownerId              String?
  description          String?
  nextStep             String?
  lostReason           String?
  wonReason            String?
  stageChangedAt       DateTime         @default(now())
  lastActivityAt       DateTime?
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company?                @relation(fields: [companyId], references: [id])
  owner              User?                   @relation("OpportunityOwner", fields: [ownerId], references: [id])
  quotations         Quotation[]
  convertedFromLeads Lead[]                  @relation("LeadConvertedOpportunity")
  activities         CrmActivity[]
  stageEvents        OpportunityStageEvent[]

  @@index([tenantId])
  @@index([stage])
  @@index([ownerId])
  @@index([tenantId, expectedCloseDate])
  @@map("opportunities")
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  type        String   @default("PRODUCT")
  price       Decimal? @db.Decimal(15, 2)
  currency    String   @default("TZS")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationLines     QuotationLine[]
  salesOrderLines    SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  stockMovements     StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

model Quotation {
  id            String    @id @default(cuid())
  tenantId      String
  opportunityId String?
  quoteNumber   String
  status        String    @default("DRAFT")
  validUntil    DateTime?
  subtotal      Decimal   @default(0) @db.Decimal(15, 2)
  tax           Decimal   @default(0) @db.Decimal(15, 2)
  total         Decimal   @default(0) @db.Decimal(15, 2)
  currency      String    @default("TZS")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id])
  lines       QuotationLine[]
  salesOrders SalesOrder[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@map("quotations")
}

model QuotationLine {
  id          String   @id @default(cuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(15, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("quotation_lines")
}

model SalesOrder {
  id          String   @id @default(cuid())
  tenantId    String
  quotationId String?
  orderNumber String
  status      String   @default("PENDING")
  orderDate   DateTime @default(now())
  subtotal    Decimal  @default(0) @db.Decimal(15, 2)
  tax         Decimal  @default(0) @db.Decimal(15, 2)
  total       Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("TZS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  lines     SalesOrderLine[]
  invoices  Invoice[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String   @id @default(cuid())
  salesOrderId String
  productId    String?
  description  String
  quantity     Decimal  @default(1) @db.Decimal(15, 3)
  unitPrice    Decimal  @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model Task {
  id          String     @id @default(cuid())
  tenantId    String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    String     @default("MEDIUM")
  assigneeId  String?
  dueDate     DateTime?
  completedAt DateTime?
  outcome     String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee   User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  activities CrmActivity[]

  @@index([tenantId])
  @@index([assigneeId])
  @@index([status])
  @@index([tenantId, dueDate])
  @@index([tenantId, relatedType, relatedId])
  @@map("tasks")
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  salesOrderId  String?
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @default(0) @db.Decimal(15, 2)
  tax           Decimal       @default(0) @db.Decimal(15, 2)
  total         Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(15, 2)
  balance       Decimal       @default(0) @db.Decimal(15, 2)
  currency      String        @default("TZS")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  payments   Payment[]
  lines      InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(15, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("TZS")
  paymentMethod String?
  reference     String?
  paidAt        DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  description String
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("TZS")
  category    String?
  vendor      String?
  expenseDate DateTime @default(now())
  status      String   @default("PENDING")
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expenseDate])
  @@map("expenses")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  tenantId     String
  supplierId   String
  poNumber     String
  status       String    @default("DRAFT")
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(15, 2)
  tax          Decimal   @default(0) @db.Decimal(15, 2)
  total        Decimal   @default(0) @db.Decimal(15, 2)
  currency     String    @default("TZS")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Decimal  @default(1) @db.Decimal(15, 3)
  unitPrice       Decimal  @db.Decimal(15, 2)
  total           Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String    @default("PLANNING")
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?  @db.Decimal(15, 2)
  currency    String    @default("TZS")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([tenantId])
  @@map("projects")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model SupportCase {
  id          String   @id @default(cuid())
  tenantId    String
  subject     String
  description String?
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("support_cases")
}

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  fileName    String
  mimeType    String?
  size        Int?
  storageKey  String
  uploadedBy  String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([relatedType, relatedId])
  @@map("documents")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A customer endorsement. Only approved, consented testimonials may be shown
/// publicly, and publication is tracked separately through `publishedAt`.
model Testimonial {
  id            String            @id @default(cuid())
  tenantId      String?
  submittedById String?
  authorName    String
  authorTitle   String?
  company       String?
  quote         String
  rating        Int               @default(5)
  status        TestimonialStatus @default(PENDING)

  /// Explicit publication consent captured at submission time.
  consentToPublish Boolean @default(false)
  consentName      Boolean @default(true)
  consentTitle     Boolean @default(true)
  consentCompany   Boolean @default(true)

  /// Moderation detail. Never exposed by the public endpoint.
  rejectionReason String?
  moderationNotes String?

  isFeatured   Boolean   @default(false)
  displayOrder Int       @default(0)
  publishedAt  DateTime?
  archivedAt   DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User?   @relation("TestimonialSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
  @@index([tenantId])
  @@index([submittedById])
  @@map("testimonials")
}

/// Physical or logical stock location owned by a tenant.
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// An immutable record of stock entering, leaving or being adjusted. Stock
/// levels are derived from these movements so quantity can never change
/// without a named actor and a reason.
model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  productId   String?
  warehouseId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(15, 3)
  unitCost    Decimal?          @db.Decimal(15, 2)
  reason      String
  reference   String?
  createdById String?
  createdAt   DateTime          @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Key/value platform configuration managed by platform administrators.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Human-entered and system-generated events shown on CRM record timelines.
model CrmActivity {
  id            String          @id @default(cuid())
  tenantId      String
  type          CrmActivityType
  subject       String
  body          String?
  source        String          @default("HUMAN")
  occurredAt    DateTime        @default(now())
  userId        String?
  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?
  taskId        String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([tenantId, opportunityId])
  @@map("crm_activities")
}

/// Immutable stage transitions used for deal aging and conversion analysis.
model OpportunityStageEvent {
  id            String            @id @default(cuid())
  tenantId      String
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  amount        Decimal?          @db.Decimal(15, 2)
  probability   Int?
  actorId       String?
  source        String            @default("HUMAN")
  createdAt     DateTime          @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, opportunityId, createdAt])
  @@map("opportunity_stage_events")
}

/// In-app notifications. No external delivery channel is implied.
model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

/// Tenant-scoped automation definition. Conditions and actions are validated
/// and executed entirely on the server.
model AutomationWorkflow {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  description String?
  trigger     AutomationTriggerType
  conditions  Json
  actions     Json
  isActive    Boolean               @default(false)
  createdById String?
  updatedById String?
  lastRunAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("AutomationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  @@index([tenantId, trigger, isActive])
  @@map("automation_workflows")
}

/// Execution record for one workflow invocation. The idempotency key prevents
/// the same event from producing duplicate side effects.
model AutomationRun {
  id             String                @id @default(cuid())
  tenantId       String
  workflowId     String
  actorId        String?
  status         AutomationRunStatus
  trigger        AutomationTriggerType
  idempotencyKey String
  attempts       Int                   @default(1)
  summary        Json?
  error          String?
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor    User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workflowId, idempotencyKey])
  @@index([tenantId, startedAt])
  @@index([tenantId, status])
  @@map("automation_runs")
}
