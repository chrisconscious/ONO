  tenantId         String
  name             String
  storageKey       String   @unique
  mimeType         String
  sizeBytes        BigInt
  entityType       String?
  entityId         String?
  uploadedByUserId String?
  isPrivate        Boolean  @default(true)
  createdAt        DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

model Notification {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?
  status    NotificationStatus  @default(UNREAD)
  link      String?
  createdAt DateTime            @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId, status])
  @@map("notifications")
}

model Kpi {
  id           String    @id @default(cuid())
  tenantId     String
  key          String
  name         String
  module       String
  unit         String?
  targetValue  Decimal?  @db.Decimal(14, 2)
  currentValue Decimal?  @db.Decimal(14, 2)
  periodStart  DateTime?
  periodEnd    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, key])
  @@index([tenantId, module])
  @@map("kpis")
}

model AiInsight {
  id               String        @id @default(cuid())
  tenantId         String
  kind             InsightKind
  status           InsightStatus @default(GENERATED)
  module           String
  title            String
  summary          String
  evidence         Json
  confidence       Float?
  sourceType       InsightSourceType @default(RULE_ENGINE)
  modelName        String?
  modelVersion     String?
  generatedAt      DateTime      @default(now())
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  actedAt          DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, kind, status])
  @@map("ai_insights")
}

model IntegrationConfig {
  id        String            @id @default(cuid())
  tenantId  String
  provider  String
  status    IntegrationStatus @default(DISABLED)
  config    Json?
  secretRef String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, provider])
  @@map("integration_configs")
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String             @unique
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(TRIALING)
  seats       Int                @default(1)
  startedAt   DateTime           @default(now())
  renewsAt    DateTime?
  cancelledAt DateTime?
  // --- Stage 14 lifecycle fields -----------------------------------------
  // Cancellation-at-period-end is deliberately separate from immediate
  // termination: cancelAtPeriodEnd marks renewal intent while access
  // continues until currentPeriodEnd.
  billingPeriod      BillingPeriod @default(MONTHLY)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean       @default(false)
  trialEndsAt        DateTime?
  updatedAt          DateTime      @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingInvoices BillingInvoice[]
  paymentAttempts PaymentAttempt[]
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// SaaS plan catalogue (ClickIT's own commercial configuration).
// Prices are stored in minor currency units as integers — never floats.
// Rows are platform-owned reference data, not tenant data.
// ---------------------------------------------------------------------------
model PlanDefinition {
  id              String           @id @default(cuid())
  code            SubscriptionPlan @unique
  name            String
  billingPeriod   BillingPeriod    @default(MONTHLY)
  priceMinor      Int              @default(0)
  currency        String           @default("TZS")
  maxSeats        Int?
  maxBranches     Int?
  includedModules String[]         @default([])
  apiLimitPerDay  Int?
  aiLimitPerDay   Int?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@map("plan_definitions")
}

// ClickIT SaaS billing invoices — kept strictly separate from tenant
// operational Invoice records (tenants invoice their own customers there).
model BillingInvoice {
  id           String             @id @default(cuid())
  number       String             @unique
  subscriptionId String
  periodStart  DateTime
  periodEnd    DateTime
  amountMinor  Int
  currency     String             @default("TZS")
  taxMinor     Int                @default(0)
  totalMinor   Int
  status       BillingInvoiceStatus @default(OPEN)
  issuedAt     DateTime           @default(now())
  paidAt       DateTime?
  providerRef  String?
  updatedAt    DateTime           @updatedAt
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     PaymentAttempt[]
  @@index([subscriptionId, status])
  @@map("billing_invoices")
}

// Records of attempts against the (future) payment provider. A row here is
// only authoritative when confirmed by a signature-verified webhook event;
// client-submitted "success" is never trusted.
model PaymentAttempt {
  id               String               @id @default(cuid())
  billingInvoiceId String
  subscriptionId   String
  status           PaymentAttemptStatus @default(PENDING)
  provider         String               @default("stub")
  providerRef      String?
  amountMinor      Int
  currency         String               @default("TZS")
  failureReason    String?
  attemptedAt      DateTime             @default(now())
  confirmedAt      DateTime?
  billingInvoice BillingInvoice @relation(fields: [billingInvoiceId], references: [id], onDelete: Restrict)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  @@unique([provider, providerRef])
  @@index([subscriptionId])
  @@map("payment_attempts")
}

// Persistent record of every externally received payment event, keyed by
// provider event id so duplicate delivery is provably processed once.
model PaymentEventLog {
  id            String           @id @default(cuid())
  provider      String
  providerEventId String
  kind          PaymentEventKind
  payloadSummary Json?
  processed     Boolean          @default(false)
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime         @default(now())
  @@unique([provider, providerEventId])
  @@index([processed, receivedAt])
  @@map("payment_event_logs")
}

// Per-tenant, per-metric, per-window usage counters. The unique key makes
// duplicate counting impossible at the database level regardless of retries.
model UsageRecord {
  id        String      @id @default(cuid())
  tenantId  String
  metric    UsageMetric
  window    String      // e.g. "2026-10" or "2026-10-27" (day window)
  value     BigInt      @default(0)
  updatedAt DateTime    @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, metric, window])
  @@index([tenantId, metric])
  @@map("usage_records")
}

// ============================================================================
// Stage 16 — Data governance, privacy, retention, consent, marketplace gates.
// Every tenant-owned governance record carries a required tenantId; platform
// registries (purposes without a tenant, marketplace products) are explicitly
// nullable/global. Fail-closed defaults: approvals start UNAPPROVED and
// review gates start NOT_STARTED, so nothing may be released automatically.
// ============================================================================

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum PurposeStatus {
  ACTIVE
  DISABLED
}

enum ProcessingApprovalState {
  UNAPPROVED
  APPROVED
  REJECTED
  BLOCKED
}

enum ConsentSubjectType {
  USER
  ORGANIZATION
}

enum RetentionAction {
  DELETE
  ANONYMIZE
  ARCHIVE
}

enum DeletionRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  BLOCKED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  NEEDS_INTERVENTION
}

enum ExportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum MarketplaceProductStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASED
  WITHDRAWN
  REJECTED
}

enum ReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
}

enum SharingArrangementStatus {
  PROPOSED
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum DataIncidentType {
  CROSS_TENANT_EXPOSURE
  UNAUTHORIZED_EXPORT
  IMPROPER_SECONDARY_USE
  UNAUTHORIZED_AI_PROCESSING
  SUSPECTED_RE_IDENTIFICATION
  UNAUTHORIZED_MARKETPLACE_RELEASE
  FAILED_DELETION_DATA_ACCESSIBLE
  UNAUTHORIZED_RESTRICTED_ACCESS
}

enum DataIncidentStatus {
  OPEN
  CONTAINED
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model DataCategory {
  id                 String             @id @default(cuid())
  tenantId           String
  code               String
  name               String
  classification     DataClassification @default(CONFIDENTIAL)
  description        String?
  isPersonalData     Boolean            @default(false)
  aiUseAllowed       Boolean            @default(false)
  marketplaceEligible Boolean           @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities         ProcessingActivity[]
  retentionPolicies  RetentionPolicy[]
  legalHolds         LegalHold[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("data_categories")
}

model ProcessingPurpose {
  id                       String              @id @default(cuid())
  tenantId                 String?
  code                     String              @unique
  name                     String
  description              String?
  status                   PurposeStatus       @default(ACTIVE)
  requiresConsent          Boolean             @default(false)
  externalSharingRestricted Boolean            @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  tenant                   Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities               ProcessingActivity[]
  sharingArrangements      DataSharingArrangement[]

  @@index([tenantId])
  @@map("processing_purposes")
}

model ProcessingActivity {
  id             String                  @id @default(cuid())
  purposeId      String
  dataCategoryId String
  state          ProcessingApprovalState @default(UNAPPROVED)
  approvedBy     String?
  approvedAt     DateTime?
  reason         String?
  purpose        ProcessingPurpose       @relation(fields: [purposeId], references: [id], onDelete: Cascade)
  dataCategory   DataCategory            @relation(fields: [dataCategoryId], references: [id], onDelete: Cascade)

  @@unique([purposeId, dataCategoryId])
  @@map("processing_activities")
}

model ConsentRecord {
  id               String             @id @default(cuid())
  tenantId         String
  userId           String?
  subjectType      ConsentSubjectType
  purposeCode      String
  policyVersion    String
  granted          Boolean
  collectionMethod String
  recordedAt       DateTime           @default(now())
  withdrawnAt      DateTime?
  evidence         String?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, purposeCode])
  @@index([userId])
  @@map("consent_records")
}

model RetentionPolicy {
  id                  String          @id @default(cuid())
  tenantId            String
  dataCategoryId      String
  version             Int             @default(1)
  // Null durationDays means the retention period is unresolved pending legal
  // review; eligibility checks must treat null as "no automatic action".
  durationDays        Int?
  triggerEvent        String          @default("RECORD_CREATED")
  action              RetentionAction @default(DELETE)
  legalBasisReference String?
  isActive            Boolean         @default(true)
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataCategory        DataCategory    @relation(fields: [dataCategoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dataCategoryId, version])
  @@index([tenantId])
  @@map("retention_policies")
}

model LegalHold {
  id             String        @id @default(cuid())
  tenantId       String
  dataCategoryId String?
  entityType     String?
  entityId       String?
  reason         String
  placedBy       String
  placedAt       DateTime      @default(now())
  releasedAt     DateTime?
  releasedBy     String?
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataCategory   DataCategory? @relation(fields: [dataCategoryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("legal_holds")
}

model DeletionRequest {
  id                        String                @id @default(cuid())
  tenantId                  String
  requestedByMembershipId   String
  scope                     String
  targetRef                 String?
  status                    DeletionRequestStatus @default(REQUESTED)
  // Unique per tenant at the database level: duplicate submissions of the
  // same logical request can never create two deletion jobs.
  idempotencyKey            String
  failureReason             String?
  completedAt               DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByMembership     Membership            @relation(fields: [requestedByMembershipId], references: [id], onDelete: Restrict)
  steps                     DeletionStep[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("deletion_requests")
}

model DeletionStep {
  id          String                @id @default(cuid())
  requestId   String
  location    String
  status      DeletionRequestStatus @default(REQUESTED)
  attempts    Int                   @default(0)
  error       String?
  completedAt DateTime?
  request     DeletionRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, location])
  @@map("deletion_steps")
}

model ExportJob {
  id                      String          @id @default(cuid())
  tenantId                String
  requestedByMembershipId String
  scope                   String
  status                  ExportJobStatus @default(PENDING)
  artifactPath            String?
  rowCount                Int?
  expiresAt               DateTime?
  failureReason           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByMembership   Membership      @relation(fields: [requestedByMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("export_jobs")
}

model AiDataUseApproval {
  id                      String                  @id @default(cuid())
  tenantId                String
  useType                 String
  dataCategoryIds         Json                    @default("[]")
  status                  ProcessingApprovalState @default(UNAPPROVED)
  requestedByMembershipId String
  decidedBy               String?
  decidedAt               DateTime?
  notes                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByMembership   Membership              @relation(fields: [requestedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([tenantId, useType])
  @@index([tenantId])
  @@map("ai_data_use_approvals")
}

model MarketplaceProduct {
  id                         String                   @id @default(cuid())
  productCode                String
  version                    Int                      @default(1)
  title                      String
  buyerCategory              String?
  intendedUseCase            String?
  aggregationMethod          String?
  includedFields             Json                     @default("[]")
  excludedFields             Json                     @default("[]")
  minGroupSize               Int?
  lineageRefs                Json                     @default("[]")
  contributingTenantIds      Json                     @default("[]")
  purposeCodes               Json                     @default("[]")
  legalReview                ReviewStatus             @default(NOT_STARTED)
  privacyReview              ReviewStatus             @default(NOT_STARTED)
  reidentificationRiskReview ReviewStatus             @default(NOT_STARTED)
  securityReview             ReviewStatus             @default(NOT_STARTED)
  dataQualityReview          ReviewStatus             @default(NOT_STARTED)
  commercialDisclosureReview ReviewStatus             @default(NOT_STARTED)
  status                     MarketplaceProductStatus @default(DRAFT)
  releaseAuthorizedBy        String?
  releaseAuthorizedAt        DateTime?
  withdrawnReason            String?
  rejectReason               String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  decisions                  MarketplaceApprovalDecision[]

  @@unique([productCode, version])
  @@index([status])
  @@map("marketplace_products")
}

model MarketplaceApprovalDecision {
  id            String             @id @default(cuid())
  productId     String
  gate          String
  decision      String
  reviewer      String
  policyVersion String?
  reason        String?
  decidedAt     DateTime           @default(now())
  product       MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("marketplace_approval_decisions")
}

model DataSharingArrangement {
  id                      String                   @id @default(cuid())
  recipientName           String
  recipientType           String
  purposeCode             String
  dataCategoryCodes       Json                     @default("[]")
  contractualReviewStatus ReviewStatus             @default(NOT_STARTED)
  authorizationStatus     ProcessingApprovalState  @default(UNAPPROVED)
  retentionRestrictions   String?
  status                  SharingArrangementStatus @default(PROPOSED)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  purpose                 ProcessingPurpose        @relation(fields: [purposeCode], references: [code], onDelete: Restrict)

  @@unique([recipientName, purposeCode])
  @@map("data_sharing_arrangements")
}

model DataIncident {
  id                      String              @id @default(cuid())
  tenantId                String?
  type                    DataIncidentType
  severity                AuditSeverity       @default(WARNING)
  status                  DataIncidentStatus  @default(OPEN)
  summary                 String
  affectedResourceRefs    Json                @default("[]")
  containmentStatus       String?
  assignedToMembershipId  String?
  openedBy                String
  openedAt                DateTime            @default(now())
  resolvedAt              DateTime?
  remediationNotes        String?
  updatedAt               DateTime            @updatedAt
  tenant                  Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignedToMembership    Membership?         @relation(fields: [assignedToMembershipId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tenantId])
  @@map("data_incidents")
}
